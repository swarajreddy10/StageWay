# Database (Supabase PostgreSQL)
DATABASE_URL=jdbc:postgresql://db.xxxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-password
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=8

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Storage (required for uploads)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=stageway-assets

# QR Secret
QR_SECRET=your-qr-secret-at-least-32-characters

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# Security (role upgrades)
APP_SECURITY_ADMIN_EMAILS=admin1@example.com,admin2@example.com
APP_SECURITY_ALLOW_SELF_UPGRADE=false
APP_STORAGE_ALLOW_LOCAL_FALLBACK=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
