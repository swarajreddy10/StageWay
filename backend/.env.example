# Database (Supabase PostgreSQL)
DATABASE_URL=jdbc:postgresql://db.xxxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-password

# QR Secret
QR_SECRET=your-qr-secret-at-least-32-characters

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# Supabase Storage (required for uploads)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=stageway-assets

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
