# Supabase Database (Production)
DATABASE_URL=jdbc:postgresql://db.[project-ref].supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-db-password
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=8

# Supabase Auth & Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Application Security
QR_SECRET=your-production-qr-secret-32-chars-minimum
APP_SECURITY_ADMIN_EMAILS=admin@yourdomain.com,support@yourdomain.com
APP_STORAGE_ALLOW_LOCAL_FALLBACK=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Server Configuration
PORT=8080

